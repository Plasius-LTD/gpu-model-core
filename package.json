{
  "name": "@plasius/gpu-model-core",
  "version": "0.1.0",
  "description": "Canonical GPU model document, resource graph, diagnostics, and adapter contracts.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTORS.md",
    "docs",
    "legal/CLA.md",
    "legal/INDIVIDUAL_CLA.md",
    "legal/CORPORATE_CLA.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "prepare": "npm run build",
    "clean": "rimraf dist",
    "test:coverage": "vitest run --coverage",
    "pack:check": "node scripts/verify-public-package.cjs",
    "prepublishOnly": "npm run build && npm run pack:check"
  },
  "keywords": [
    "webgpu",
    "wgsl",
    "gpu-model",
    "gpu-layout",
    "shader-compatibility",
    "asset-contracts",
    "typescript",
    "typesafe",
    "runtime-validation",
    "type-safety",
    "plasius",
    "model-manifest",
    "model-assets",
    "gpu-abi",
    "shader-style",
    "abi",
    "rendering",
    "oss",
    "portable",
    "monorepo-friendly"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "dependencies": {
    "@plasius/asset-contracts": "^0.3.1",
    "@plasius/gpu-shader": "^0.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/gpu-model-core.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/gpu-model-core/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/gpu-model-core#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.28.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/plasiusltd/membership"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Plasius-LTD"
    }
  ],
  "overrides": {
    "esbuild": "^0.28.1",
    "minimatch": "^10.2.1"
  },
  "engines": {
    "node": ">=24"
  }
}
